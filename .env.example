NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/home-hub.sqlite
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LUCKY_BASE_URL=
# Lucky 3.x candidate endpoint; override after verifying the installed version.
LUCKY_RULES_PATH=/api/webservice/rules
LUCKY_TOKEN=
LUCKY_TOKEN_HEADER=openToken
LUCKY_TOKEN_PREFIX=
PVE_BASE_URL=https://pve.example.local:8006
# Use a dedicated read-only PVE token with the PVEAuditor role.
PVE_TOKEN_ID=monitor@pve!homehub
PVE_TOKEN_SECRET=
# Optional PEM CA certificate for a private PVE certificate authority.
PVE_CA_CERT_PATH=
PVE_TIMEOUT_MS=5000
PVE_POLL_INTERVAL_MS=60000
# QWeather JWT credentials. Keep the private key in deployment secrets, not Git.
QWEATHER_API_HOST=https://your-project.qweatherapi.com
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
# PEM newlines may be represented as literal \n characters.
QWEATHER_PRIVATE_KEY=
# uni-push 1.0 / Getui REST V2. Leave empty to keep messages without sending push.
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=
# Must match the Android package name used in HBuilderX signed builds.
GETUI_ANDROID_PACKAGE=

# 缠境上游：专用 Token 需要 read:market/read:watchlist/write:watchlist。
TICK_STOCK_API_URL=
TICK_STOCK_API_TOKEN=
TICK_STOCK_TIMEOUT_MS=30000
